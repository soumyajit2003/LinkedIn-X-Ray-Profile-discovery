SERPER_API_KEY=your_serper_api_key_here
LOG_LEVEL=INFO

# AI Provider Keys (optional — can also be set via Settings UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AWS Bedrock (requires ~/.aws/credentials for IAM auth)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
